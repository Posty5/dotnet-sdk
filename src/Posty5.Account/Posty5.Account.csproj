<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- NuGet Package Properties -->
    <PackageId>Posty5.Account</PackageId>
    <Version>3.1.0</Version>
    <Authors>Posty5</Authors>
    <Company>Posty5</Company>
    <Description>Account client for Posty5 .NET SDK - who the API key belongs to, its plan and credits, credit history, and the live price of every operation</Description>
    <PackageTags>posty5;account;api-key;credits;usage;pricing;api;sdk</PackageTags>
    <PackageProjectUrl>https://posty5.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/posty5/dotnet-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Posty5.Core\Posty5.Core.csproj" />
  </ItemGroup>

</Project>
